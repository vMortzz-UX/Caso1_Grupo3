@model CRUDProductosMVC.Models.Producto
@using System.Collections.Generic

@{
    ViewBag.Title = "Crear producto";
}

<h2>Crear producto</h2>

@using (Html.BeginForm("Create", "Productos", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />

        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.Codigo)
            @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Nombre)
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Categoria)
            @Html.TextBoxFor(m => m.Categoria, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Precio)
            @Html.TextBoxFor(m => m.Precio, new Dictionary<string, object>
        {
                { "class", "form-control" },
                { "type", "number" },
                { "step", "0.01" },
                { "min", "0.01" }
            })
            @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Existencia)
            @Html.TextBoxFor(m => m.Existencia, new Dictionary<string, object>
        {
                { "class", "form-control" },
                { "type", "number" },
                { "min", "0" },
                { "max", "9999" }
            })
            @Html.ValidationMessageFor(m => m.Existencia, "", new { @class = "text-danger" })
        </div>

        <div class="checkbox">
            <label>
                @Html.CheckBoxFor(m => m.Activo)
                Producto activo
            </label>
        </div>

        <br />

        <button type="submit" class="btn btn-primary">Guardar producto</button>

        @Html.ActionLink(
                 "Volver al listado",
                 "Index",
                 "Productos",
                 null,
                 new { @class = "btn btn-default" }
             )
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}