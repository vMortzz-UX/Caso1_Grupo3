
@model IEnumerable<CRUDProductosMVC.Models.Producto>

@{
    ViewBag.Title = "Productos";
}

<h2>Lista de productos</h2>

<p>
    @Html.ActionLink("Agregar producto", "Create")
</p>

<table class="table table-bordered">
    <tr>
        <th>Código</th>
        <th>Nombre</th>
        <th>Categoría</th>
        <th>Precio</th>
        <th>Existencia</th>
        <th>Estado</th>
        <th>Acciones</th>
    </tr>

    @foreach (var producto in Model)
    {
        <tr>
            <td>@producto.Codigo</td>
            <td>@producto.Nombre</td>
            <td>@producto.Categoria</td>
            <td>@producto.Precio</td>
            <td>@producto.Existencia</td>
            <td>@(producto.Activo ? "Activo" : "Inactivo")</td>
            <td>
                @Html.ActionLink("Detalles", "Details", new { id = producto.Id }) |
                @Html.ActionLink("Editar", "Edit", new { id = producto.Id }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = producto.Id })
            </td>
        </tr>
    }
</table>
