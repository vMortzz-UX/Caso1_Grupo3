
@model CRUDProductosMVC.Models.Producto

@{
    ViewBag.Title = "Editar producto";
}

<h2>Editar producto</h2>

@using (Html.BeginForm("Edit", "Productos", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)

    <hr />

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Codigo, "Código")
        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Nombre, "Nombre")
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Categoria, "Categoría")
        @Html.TextBoxFor(m => m.Categoria, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Precio, "Precio")
        @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
        @Html.ValidationMessageFor(m => m.Precio, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Existencia, "Existencia")
        @Html.TextBoxFor(m => m.Existencia, new { @class = "form-control", type = "number", min = "0", max = "9999" })
        @Html.ValidationMessageFor(m => m.Existencia, "", new { @class = "text-danger" })
    </div>

    <div class="checkbox">
        <label>
            @Html.CheckBoxFor(m => m.Activo)
            Producto activo
        </label>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Guardar cambios</button>

    @Html.ActionLink("Cancelar", "Index", "Productos", null, new { @class = "btn btn-default" })
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}